<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/app_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/shell_surface">

    <WebView
        android:id="@+id/coast_webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@color/shell_surface"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="vertical" />

    <ProgressBar
        android:id="@+id/page_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_gravity="top"
        android:max="100"
        android:progressBackgroundTint="@color/coast_transparent"
        android:progressTint="@color/coast_gold"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/loading_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/shell_surface"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <ImageView
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:background="@drawable/bg_icon_round"
            android:clipToOutline="true"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/coast_icon" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/app_name"
            android:textColor="@color/shell_text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/loading_coast"
            android:textColor="@color/shell_text_secondary"
            android:textSize="13sp" />

        <ProgressBar
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginTop="18dp"
            android:indeterminateTint="@color/coast_gold" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/error_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/shell_surface"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="36dp"
            android:paddingEnd="28dp"
            android:paddingBottom="36dp">

            <ImageView
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:background="@drawable/bg_icon_round"
                android:clipToOutline="true"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/coast_icon" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:text="@string/network_error_title"
                android:textColor="@color/shell_text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/error_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="@string/network_error_message"
                android:textColor="@color/shell_text_secondary"
                android:textSize="14sp" />

            <Button
                android:id="@+id/retry_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_button_primary"
                android:minHeight="48dp"
                android:text="@string/retry"
                android:textAllCaps="false"
                android:textColor="@color/coast_navy_dark"
                android:textStyle="bold" />

            <Button
                android:id="@+id/open_browser_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_button_secondary"
                android:minHeight="48dp"
                android:text="@string/open_browser"
                android:textAllCaps="false"
                android:textColor="@color/shell_text_primary" />

            <Button
                android:id="@+id/clear_cache_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_button_secondary"
                android:minHeight="48dp"
                android:text="@string/clear_cache_reload"
                android:textAllCaps="false"
                android:textColor="@color/shell_text_primary" />
        </LinearLayout>
    </ScrollView>

    <ImageButton
        android:id="@+id/shell_menu_button"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_gravity="top|end"
        android:layout_margin="10dp"
        android:alpha="0.94"
        android:background="@drawable/bg_shell_menu_button"
        android:contentDescription="@string/shell_menu"
        android:elevation="6dp"
        android:padding="9dp"
        android:src="@drawable/ic_more_vert" />

</FrameLayout>
