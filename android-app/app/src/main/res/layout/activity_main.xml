<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/app_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/coast_navy">

    <LinearLayout
        android:id="@+id/home_screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/coast_navy"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="18dp"
            android:paddingEnd="10dp"
            android:paddingBottom="12dp">

            <ImageView
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/coast_icon" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="13dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/coast_white"
                    android:textSize="25sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/home_subtitle"
                    android:textColor="@color/coast_text_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/home_menu_button"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_shell_menu_button"
                android:contentDescription="@string/shell_menu"
                android:padding="10dp"
                android:src="@drawable/ic_more_vert" />
        </LinearLayout>

        <TextView
            android:id="@+id/home_sync_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_sync_note"
            android:paddingStart="13dp"
            android:paddingTop="9dp"
            android:paddingEnd="13dp"
            android:paddingBottom="9dp"
            android:text="@string/home_ready_note"
            android:textColor="@color/coast_gold_soft"
            android:textSize="12sp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="ifContentScrolls"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="22dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/room_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/room_screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/shell_surface"
        android:orientation="vertical"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/room_content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/shell_surface">

            <WebView
                android:id="@+id/coast_webview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/shell_surface"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:overScrollMode="ifContentScrolls"
                android:scrollbars="vertical" />

            <ProgressBar
                android:id="@+id/page_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_gravity="top"
                android:max="100"
                android:progressBackgroundTint="@color/coast_transparent"
                android:progressTint="@color/coast_gold"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/room_skeleton"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/shell_surface"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="30dp">

                <ImageView
                    android:layout_width="104dp"
                    android:layout_height="104dp"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:src="@drawable/coast_icon" />

                <TextView
                    android:id="@+id/skeleton_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="center"
                    android:textColor="@color/shell_text_primary"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/skeleton_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/shell_text_secondary"
                    android:textSize="13sp" />

                <ProgressBar
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginTop="19dp"
                    android:indeterminateTint="@color/coast_gold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:text="@string/syncing_room"
                    android:textColor="@color/shell_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/local_room_panel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/shell_surface"
                android:fillViewport="true"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="24dp"
                    android:paddingTop="28dp"
                    android:paddingEnd="24dp"
                    android:paddingBottom="32dp">

                    <ImageView
                        android:layout_width="88dp"
                        android:layout_height="88dp"
                        android:layout_gravity="center_horizontal"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop"
                        android:src="@drawable/coast_icon" />

                    <TextView
                        android:id="@+id/local_room_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="19dp"
                        android:gravity="center"
                        android:textColor="@color/shell_text_primary"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/local_room_body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="17dp"
                        android:lineSpacingExtra="4dp"
                        android:textColor="@color/shell_text_secondary"
                        android:textIsSelectable="true"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/local_primary_button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:background="@drawable/bg_button_primary"
                        android:minHeight="48dp"
                        android:textAllCaps="false"
                        android:textColor="@color/coast_navy_dark"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/local_secondary_button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_button_secondary"
                        android:minHeight="48dp"
                        android:text="@string/open_browser"
                        android:textAllCaps="false"
                        android:textColor="@color/shell_text_primary" />
                </LinearLayout>
            </ScrollView>

            <ScrollView
                android:id="@+id/error_panel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/shell_surface"
                android:fillViewport="true"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingStart="28dp"
                    android:paddingTop="36dp"
                    android:paddingEnd="28dp"
                    android:paddingBottom="36dp">

                    <ImageView
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop"
                        android:src="@drawable/coast_icon" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:gravity="center"
                        android:text="@string/network_error_title"
                        android:textColor="@color/shell_text_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/error_message"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:lineSpacingExtra="3dp"
                        android:text="@string/network_error_message"
                        android:textColor="@color/shell_text_secondary"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/retry_button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:background="@drawable/bg_button_primary"
                        android:minHeight="48dp"
                        android:text="@string/retry"
                        android:textAllCaps="false"
                        android:textColor="@color/coast_navy_dark"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/open_browser_button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_button_secondary"
                        android:minHeight="48dp"
                        android:text="@string/open_browser"
                        android:textAllCaps="false"
                        android:textColor="@color/shell_text_primary" />

                    <Button
                        android:id="@+id/clear_cache_button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_button_secondary"
                        android:minHeight="48dp"
                        android:text="@string/clear_cache_reload"
                        android:textAllCaps="false"
                        android:textColor="@color/shell_text_primary" />
                </LinearLayout>
            </ScrollView>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/room_navigation"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@color/coast_navy"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <ImageButton
                android:id="@+id/room_back_button"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_bottom_nav_button"
                android:contentDescription="@string/back_to_rooms"
                android:padding="10dp"
                android:src="@drawable/ic_arrow_back" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/room_nav_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/coast_white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/room_nav_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/local_room_ready"
                    android:textColor="@color/coast_text_muted"
                    android:textSize="10sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/room_menu_button"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_bottom_nav_button"
                android:contentDescription="@string/shell_menu"
                android:padding="10dp"
                android:src="@drawable/ic_more_vert" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
