<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="16dp" />
            <solid android:color="@color/shell_menu_pressed" />
            <stroke android:width="1dp" android:color="@color/coast_gold_soft" />
            <padding android:bottom="10dp" android:left="20dp" android:right="20dp" android:top="10dp" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="16dp" />
            <solid android:color="@color/coast_transparent" />
            <stroke android:width="1dp" android:color="@color/shell_divider" />
            <padding android:bottom="10dp" android:left="20dp" android:right="20dp" android:top="10dp" />
        </shape>
    </item>
</selector>
