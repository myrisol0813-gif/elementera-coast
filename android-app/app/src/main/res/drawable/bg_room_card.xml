<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="16dp" />
            <solid android:color="#293566" />
            <stroke android:width="1dp" android:color="#66FFD477" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="16dp" />
            <solid android:color="#202B58" />
            <stroke android:width="1dp" android:color="#2FFFD477" />
        </shape>
    </item>
</selector>
